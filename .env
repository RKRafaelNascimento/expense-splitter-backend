# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

PORT=3000
NODE_ENV=prod

LOGGER_LEVEL=debug
LOGGER_ENABLED=true
LOGGER_PRETTY_PRINT=true

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expensesplitter?schema=public"

# It was a temporary credential and was deleted as well. The goal was to allow the developer to check the infrastructure that was provided. That's why I committed this part.

AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_EXPENSE_BATCH="expense-batch"

SES_REICEIVER_EMAIL=
SES_SENDER_EMAIL=